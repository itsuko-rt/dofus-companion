# Copy to .env.local (never commit real values). Every variable is optional: without it the feature stays off.

# Public address, used for canonical URLs, sitemap.xml and social cards
NEXT_PUBLIC_SITE_URL=https://example.org

# Account database location (Node hosting). Back this file up.
APP_DB_PATH=data/app.sqlite

# Cloudflare Web Analytics token (dashboard > Web Analytics > add site > JS snippet)
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Google AdSense — leave empty until the account is approved AND the Privacy & messaging CMP is published
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES=

# Legal notice (France, LCEN): shown on /mentions-legales, kept out of the repository
LEGAL_PUBLISHER=
LEGAL_CONTACT=
LEGAL_HOST=

# Header the reverse proxy sets with the real client address (Cloudflare: cf-connecting-ip). Leave empty without a proxy.
TRUSTED_IP_HEADER=
